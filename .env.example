# Database Configuration (SQLite by default; or use postgresql://user:pass@localhost:5432/aco_db)
DATABASE_URL=sqlite:///./aco_ecg.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Microservices URLs
ORDER_SERVICE_URL=http://127.0.0.1:8001
PAYMENT_SERVICE_URL=http://127.0.0.1:8002

# PCAE Algorithm Defaults
DEFAULT_ALPHA=0.25
DEFAULT_BETA=0.25
DEFAULT_GAMMA=0.25
DEFAULT_DELTA=0.25

# Prediction Sigmoid Parameters
PRED_K=8.0
PRED_M=3.5
PRED_TAU=0.80

# Pre-Emptive Gating Thresholds
GATE_ALLOW_THRESHOLD=0.25
GATE_DEGRADE_THRESHOLD=0.50
GATE_REROUTE_THRESHOLD=0.75
GATE_HYSTERESIS_DELTA=0.05
